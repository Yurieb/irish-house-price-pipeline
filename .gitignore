# Secrets - real credentials live in .env, which is never committed
.env

# Data files - downloaded and generated by the pipeline, never committed.
# The .gitkeep files keep the empty folders in the repo.
data/raw/*
data/clean/*
!data/raw/.gitkeep
!data/clean/.gitkeep

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# dbt build output
dbt/target/
dbt/dbt_packages/
dbt/logs/
logs/
.user.yml

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

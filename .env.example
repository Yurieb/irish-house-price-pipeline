# Copy this to .env and fill in your own values.
# .env is in .gitignore so the real password never gets committed.

POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change_me
POSTGRES_DB=house_prices
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# read-only user for the "ask the data" feature, created by src/create_readonly_user.py.
# keep the name as ask_reader, the monthly dbt refresh re-grants access to that name
ASK_POSTGRES_USER=ask_reader
ASK_POSTGRES_PASSWORD=change_me_too
